# Copy this file to .env and fill in your own values. Never commit .env.
# Module 1: copy the endpoint from your Foundry project home page
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/fjordtrips

# Module 3: embedding model deployment
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Module 6: chat model deployment
CHAT_DEPLOYMENT=gpt-5-mini

# Module 8: the agent you created in the portal (Module 7)
AGENT_NAME=trip-agent

# Module 9: Azure Language (endpoint and key from the Language service: paste the key off screen)
LANGUAGE_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/
LANGUAGE_KEY=

# Module 10: audio model deployment and Azure Speech
AUDIO_DEPLOYMENT=<audio-deployment-name>
SPEECH_KEY=
SPEECH_REGION=swedencentral

# Module 11: image generation deployment
IMAGE_DEPLOYMENT=gpt-image-1-mini

# Module 12: Content Understanding (your Foundry resource endpoint) and the public data folder of your repo
CU_ENDPOINT=https://<resource-name>.services.ai.azure.com/
DATA_BASE_URL=https://raw.githubusercontent.com/<your-account>/fjord-trips-ai901/main/data

# Module 16: a cheaper model to compare costs
CHEAP_DEPLOYMENT=gpt-5-nano
